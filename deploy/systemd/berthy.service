[Unit]
Description=Berthy agent
After=network-online.target
Wants=network-online.target

[Service]
User=berthy
Group=berthy
SupplementaryGroups=docker
ExecStart=/usr/local/bin/berthy agent --config /etc/berthy/agent.json
Restart=on-failure
NoNewPrivileges=true
StateDirectory=berthy
UMask=0077

[Install]
WantedBy=multi-user.target
